# Copia este archivo como backend/.env y completa tu clave de IonQ
# (cloud.ionq.com → API Keys). Nunca subas el .env al repositorio.
IONQ_API_KEY=
# Modelo de ruido del simulador de IonQ: forte-1 | aria-1 | ideal
IONQ_NOISE_MODEL=forte-1
# Las corridas en QPU cuestan dinero: cámbialo a true sólo cuando estén listos.
ALLOW_QPU=false
HOST=127.0.0.1
PORT=8000
